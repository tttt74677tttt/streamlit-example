    <string name="why_android_auto_body">Apple CarPlay only works with iPhone. On Android, the supported path is Android Auto (phone projection) or Android Automotive OS (built into the car).</string>
    <string name="steps_title">How to connect</string>
    <string name="step_1">Install Android Auto on your phone (Android 11+).</string>
    <string name="step_2">Use a quality USB cable, or enable Wireless Android Auto if your car supports it.</string>
